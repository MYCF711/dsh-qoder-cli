{
  "name": "dsh-qoder-cli",
  "displayName": "DSH Qoder Connect",
  "description": "Reuse the Qoder desktop app's sign-in or run the Qoder device login from the card to bring Qoder's models into DeepSeek Harness — 10 live-verified model keys over the Qoder model gateway, with an expandable settings card in the Web UI.",
  "version": "0.3.0",
  "author": "local",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "qoder",
    "qoder-cli",
    "model-provider"
  ],
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node test/core.test.mjs && node test/store.test.mjs && node test/shim.test.mjs && node test/device-login.test.mjs",
    "test:all": "node test/run-all.mjs"
  },
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MYCF711/dsh-qoder-cli.git"
  },
  "homepage": "https://github.com/MYCF711/dsh-qoder-cli#readme",
  "bugs": {
    "url": "https://github.com/MYCF711/dsh-qoder-cli/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings-plugins",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-home-paths": ">=0.1.2-rc.1 <0.2.0",
    "@deepseek-ai/dsh-host-webserver": ">=0.1.2-rc.1 <0.2.0",
    "@deepseek-ai/dsh-llm": ">=0.1.2-rc.1 <0.2.0",
    "@deepseek-ai/dsh-llm-pi-ai": ">=0.1.2-rc.1 <0.2.0",
    "@deepseek-ai/dsh-settings": ">=0.1.2-rc.1 <0.2.0",
    "@deepseek-ai/schemastery": "^3.18.2",
    "@earendil-works/pi-ai": ">=0.84.2 <0.86.0",
    "koffi": "3.1.5",
    "react": "^18.2.0"
  }
}