Thumbs.db
Desktop.ini
# Internal handoff notes — not for public distribution
docs/EXPERIENCE-MEMORY.md

# --- Public-distribution exclusions (added 2026-09-21) ---
# The auth WASM is Qoder's official 298KB binary. It is deliberately NOT
# shipped: redistributing it is a ToS and licensing problem, and it is only
# needed by the experimental remote-catalog tier (which ships disabled).
# Supply it locally via QODER_AUTH_WASM_PATH when you need that tier.
lib/qoder/wasm/
QODER_AUTH_WASM_PATH

